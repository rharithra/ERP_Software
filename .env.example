# Copy to `.env` for Docker Compose. Do not commit real secrets.
#
# Local `mvn spring-boot:run` (profile `local`) may omit JWT_SECRET and will use the
# documented development-only default in application.yml. Docker and any non-local
# profile require JWT_SECRET and reject that known default.
#
# Generate a secret:
#   openssl rand -base64 48

DATABASE_PASSWORD=retailflow_dev
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:38421,http://127.0.0.1:38421
